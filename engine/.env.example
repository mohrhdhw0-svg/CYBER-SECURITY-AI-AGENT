ENGINE_API_TOKEN=replace-with-a-long-random-secret
# Required: set only public IPs/CIDRs that you own or are explicitly authorized to test.
# Leave empty until you have selected the exact authorized target ranges; scans remain disabled.
AUTHORIZED_CIDRS=

# Required for durable scan idempotency and safe queue redelivery; use the same persistent Upstash database as the app.
UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
