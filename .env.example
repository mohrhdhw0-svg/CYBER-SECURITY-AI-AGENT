# Copy required values into your hosting provider's encrypted environment settings.
# Never commit real credentials or paste them into source files.

# Vercel web application
ENGINE_URL=https://your-engine-service.example
ENGINE_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_PANEL_PASSWORD=
# Use independently generated random secrets (at least 32 bytes each).
ADMIN_SESSION_SECRET=
SCAN_APPROVAL_SECRET=

# Optional: enables reputation enrichment; without it, this source is omitted.
ABUSEIPDB_API_KEY=

# Render engine service (set these in the engine service environment)
# ENGINE_API_TOKEN must match the Vercel value above.
# SCAN_APPROVAL_SECRET must match the Vercel value above.
